<!-- Torrent loading screen (view/torrent_loading.cpp), over the player until mpv has data:
     the item's backdrop under a dark scrim, its logo (or its title) in the middle, then a
     progress bar, the stage and the peers and speed. -->
<brls:Box
    width="100%"
    height="100%"
    positionType="absolute"
    positionTop="0"
    positionLeft="0"
    axis="column"
    justifyContent="center"
    alignItems="center"
    backgroundColor="#000000FF">

    <brls:Image
        id="torrent/backdrop"
        positionType="absolute"
        positionTop="0"
        positionLeft="0"
        width="100%"
        height="100%"
        scalingType="fill" />

    <brls:Box
        positionType="absolute"
        positionTop="0"
        positionLeft="0"
        width="100%"
        height="100%"
        backgroundColor="#000000B8" />

    <brls:Image
        id="torrent/logo"
        width="440"
        height="120"
        scalingType="fit"
        visibility="gone" />

    <brls:Label
        id="torrent/title"
        fontSize="34"
        textColor="#FFFFFFFF"
        horizontalAlign="center" />

    <brls:Box
        width="420"
        height="6"
        marginTop="48"
        cornerRadius="3"
        backgroundColor="#FFFFFF33">
        <brls:Box
            id="torrent/bar/fill"
            width="0"
            height="6"
            cornerRadius="3"
            backgroundColor="@theme/color/app" />
    </brls:Box>

    <brls:Label
        id="torrent/stage"
        fontSize="18"
        marginTop="18"
        textColor="#FFFFFFFF"
        horizontalAlign="center" />

    <brls:Label
        id="torrent/stats"
        fontSize="15"
        marginTop="8"
        textColor="#FFFFFFB3"
        horizontalAlign="center" />

</brls:Box>
