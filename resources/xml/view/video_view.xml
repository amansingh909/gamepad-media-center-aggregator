<brls:Box
    width="100%"
    height="100%"
    axis="column"
    justifyContent="spaceBetween"
    alignItems="center">

    <brls:Box
        id="video/osd/top/box"
        width="100%"
        height="110"
        backgroundStartColor="#000000D5"
        backgroundEndColor="#00000000"
        background="vertical_linear">

        <brls:Box
            id="video/close/box"
            hideClickAnimation="true"
            marginLeft="10"
            marginRight="10"
            marginTop="6"
            alignItems="center"
            justifyContent="center"
            focusable="true"
            hideHighlightBorder="true"
            highlightBackgroundColor="@theme/color/focus/bg"
            highlightCornerRadius="24"
            width="48"
            height="48">
            <SVGImage
                id="video/close/icon"
                height="26"
                width="26"
                svg="@res/icon/ico-close.svg" />
        </brls:Box>

        <brls:Label
            id="video/osd/title"
            height="100%"
            marginLeft="20"
            marginRight="280"
            singleLine="true"
            textColor="@theme/color/white" />

        <brls:Box
            positionType="absolute"
            positionRight="10"
            positionTop="10">
            <brls:Box
                wireframe="false"
                id="video/osd/backward"
                visibility="gone"
                alignItems="center"
                justifyContent="center"
                height="50"
                width="50">
                <SVGImage
                    id="video/osd/backward/icon"
                    focusable="true"
                    visibility="gone"
                    hideHighlightBorder="true"
                    highlightBackgroundColor="@theme/color/focus/bg"
                    highlightPadding="10"
                    highlightCornerRadius="25"
                    height="30"
                    width="30"
                    svg="@res/icon/ico-backward.svg" />
            </brls:Box>
            <brls:Box
                wireframe="false"
                id="video/osd/seek/back"
                alignItems="center"
                justifyContent="center"
                height="50"
                width="50">
                <SVGImage
                    id="video/osd/seek/back/icon"
                    focusable="true"
                    hideHighlightBorder="true"
                    highlightBackgroundColor="@theme/color/focus/bg"
                    highlightPadding="10"
                    highlightCornerRadius="25"
                    height="30"
                    width="30"
                    svg="@res/icon/ico-seek-back.svg" />
            </brls:Box>
            <brls:Box
                wireframe="false"
                id="video/osd/seek/forward"
                alignItems="center"
                justifyContent="center"
                height="50"
                width="50">
                <SVGImage
                    id="video/osd/seek/forward/icon"
                    focusable="true"
                    hideHighlightBorder="true"
                    highlightBackgroundColor="@theme/color/focus/bg"
                    highlightPadding="10"
                    highlightCornerRadius="25"
                    height="30"
                    width="30"
                    svg="@res/icon/ico-seek-forward.svg" />
            </brls:Box>
            <brls:Box
                wireframe="false"
                id="video/osd/forward"
                visibility="gone"
                alignItems="center"
                justifyContent="center"
                height="50"
                width="50">
                <SVGImage
                    id="video/osd/forward/icon"
                    focusable="true"
                    visibility="gone"
                    hideHighlightBorder="true"
                    highlightBackgroundColor="@theme/color/focus/bg"
                    highlightPadding="10"
                    highlightCornerRadius="25"
                    height="30"
                    width="30"
                    svg="@res/icon/ico-forward.svg" />
            </brls:Box>
            <brls:Box
                wireframe="false"
                id="video/osd/setting"
                hideClickAnimation="true"
                alignItems="center"
                justifyContent="center"
                height="50"
                width="50">
                <SVGImage
                    id="video/osd/setting/icon"
                    focusable="true"
                    hideHighlightBorder="true"
                    highlightBackgroundColor="@theme/color/focus/bg"
                    highlightPadding="10"
                    highlightCornerRadius="25"
                    height="30"
                    width="30"
                    svg="@res/icon/ico-player-setting.svg" />
            </brls:Box>
        </brls:Box>

        <brls:Box
            id="video/speed/hint/box"
            width="100%"
            positionBottom="-10"
            visibility="gone"
            positionType="absolute"
            justifyContent="center"
            alignItems="center">
            <brls:Box
                backgroundColor="#00000080"
                cornerRadius="4"
                justifyContent="center"
                alignItems="center">
                <brls:Label
                    marginLeft="64"
                    marginRight="8"
                    marginTop="6"
                    marginBottom="6"
                    textColor="@theme/color/white"
                    id="video/speed/hint/label" />
            </brls:Box>
        </brls:Box>
    </brls:Box>

    <brls:Box
        axis="column"
        alignItems="center"
        justifyContent="center"
        visibility="gone"
        cornerRadius="4"
        width="100"
        height="100"
        backgroundColor="#303030A0"
        id="video/osd/info/box">
        <SVGImage
            id="video/osd/info/icon"
            height="30"
            width="30"
            marginBottom="20" />
        <brls:Label
            id="video/osd/info/label"
            textColor="@theme/color/white"
            fontSize="24"
            height="16"
            horizontalAlign="center"
            verticalAlign="center" />
    </brls:Box>

    <brls:Box
        axis="column"
        alignItems="center"
        id="video/osd/center/box">
        <brls:ProgressSpinner
            id="video/osd/loading"
            width="100"
            height="100" />
        <brls:Label
            id="video/osd/center/label"
            visibility="invisible"
            cornerRadius="4"
            backgroundColor="#303030A0"
            textColor="@theme/color/white"
            fontSize="16"
            height="16"
            horizontalAlign="center"
            verticalAlign="center" />
    </brls:Box>

    <!-- the OSD's middle and bottom rows; the D-pad routes between all three rows are set in
         VideoView::applyFocusRoutes() from view/osd_controls.hpp -->
    <brls:Box
        id="video/osd/bottom/box"
        width="100%"
        height="160"
        axis="column"
        justifyContent="flexEnd"
        paddingBottom="16"
        backgroundStartColor="#00000000"
        backgroundEndColor="#000000D5"
        background="vertical_linear">

        <!-- middle row: play/pause, the progress bar, time / duration -->
        <brls:Box
            id="video/osd/main/row"
            width="100%"
            height="70"
            axis="row"
            alignItems="center">
            <brls:Box
                id="video/osd/toggle"
                wireframe="false"
                focusable="true"
                hideHighlightBorder="true"
                highlightBackgroundColor="@theme/color/focus/bg"
                highlightPadding="8"
                highlightCornerRadius="38"
                alignItems="center"
                justifyContent="center"
                marginLeft="20"
                marginRight="10"
                height="60"
                width="60">
                <SVGImage
                    id="video/osd/toggle/icon"
                    wireframe="false"
                    height="60"
                    width="60"
                    svg="@res/icon/ico-play.svg" />
            </brls:Box>
            <VideoProgressSlider
                focusable="false"
                id="video/osd/bottom/progress"
                width="auto"
                height="50"
                grow="1" />
            <brls:Box
                height="100%"
                marginRight="20"
                alignItems="center">
                <brls:Label
                    wireframe="false"
                    horizontalAlign="right"
                    id="video/left/status"
                    height="100%"
                    width="90"
                    textColor="@theme/color/white"
                    text="00:00" />
                <brls:Label
                    horizontalAlign="center"
                    height="100%"
                    marginLeft="6"
                    marginRight="6"
                    textColor="@theme/color/white"
                    text="/" />
                <brls:Label
                    wireframe="false"
                    horizontalAlign="left"
                    id="video/right/status"
                    height="100%"
                    width="90"
                    textColor="@theme/color/white"
                    text="00:00" />
            </brls:Box>
        </brls:Box>

        <!-- bottom row: volume, Episodes, audio, subtitles, quality, then Lock. Locked, only
             Lock stays (VideoView::toggleOSDLock()) -->
        <brls:Box
            id="video/osd/buttons/row"
            width="100%"
            height="60"
            axis="row"
            alignItems="center"
            paddingLeft="20">
            <brls:Box
                id="video/osd/buttons"
                axis="row"
                alignItems="center">
                <brls:Box
                    id="video/osd/volume"
                    hideClickAnimation="true"
                    marginLeft="6"
                    marginRight="6"
                    alignItems="center"
                    justifyContent="center"
                    height="60"
                    width="50">
                    <SVGImage
                        focusable="true"
                        id="video/osd/volume/icon"
                        hideHighlightBorder="true"
                        highlightBackgroundColor="@theme/color/focus/bg"
                        highlightPadding="10"
                        highlightCornerRadius="25"
                        wireframe="false"
                        height="30"
                        width="30"
                        svg="@res/icon/ico-volume.svg" />
                </brls:Box>
                <brls:Box
                    id="show/episode/box"
                    hideClickAnimation="true"
                    marginLeft="10"
                    marginRight="10"
                    visibility="gone"
                    alignItems="center"
                    justifyContent="center"
                    height="60">
                    <brls:Label
                        id="show/episode/label"
                        textColor="@theme/color/white"
                        focusable="true"
                        visibility="gone"
                        horizontalAlign="center"
                        text="@i18n/main/player/episode"
                        hideHighlightBorder="true"
                        highlightBackgroundColor="@theme/color/focus/bg"
                        highlightPadding="6"
                        highlightCornerRadius="8" />
                </brls:Box>
                <brls:Box
                    id="video/audio/box"
                    hideClickAnimation="true"
                    marginLeft="6"
                    marginRight="6"
                    alignItems="center"
                    justifyContent="center"
                    height="60"
                    width="50">
                    <SVGImage
                        id="video/audio/icon"
                        focusable="true"
                        hideHighlightBorder="true"
                        highlightBackgroundColor="@theme/color/focus/bg"
                        highlightPadding="10"
                        highlightCornerRadius="25"
                        height="28"
                        width="28"
                        svg="@res/icon/ico-audio.svg" />
                </brls:Box>
                <brls:Box
                    id="video/subtitle/box"
                    hideClickAnimation="true"
                    marginLeft="6"
                    marginRight="6"
                    alignItems="center"
                    justifyContent="center"
                    height="60"
                    width="50">
                    <SVGImage
                        id="video/subtitle/icon"
                        focusable="true"
                        hideHighlightBorder="true"
                        highlightBackgroundColor="@theme/color/focus/bg"
                        highlightPadding="10"
                        highlightCornerRadius="25"
                        height="28"
                        width="28"
                        svg="@res/icon/ico-subtitle.svg" />
                </brls:Box>
                <brls:Box
                    id="video/quality/box"
                    hideClickAnimation="true"
                    marginLeft="6"
                    marginRight="6"
                    alignItems="center"
                    justifyContent="center"
                    height="60"
                    width="50">
                    <SVGImage
                        id="video/quality/icon"
                        focusable="true"
                        hideHighlightBorder="true"
                        highlightBackgroundColor="@theme/color/focus/bg"
                        highlightPadding="10"
                        highlightCornerRadius="25"
                        height="28"
                        width="28"
                        svg="@res/icon/ico-quality.svg" />
                </brls:Box>
            </brls:Box>
            <brls:Box
                id="video/osd/lock/box"
                focusable="true"
                hideHighlightBorder="true"
                highlightBackgroundColor="@theme/color/focus/bg"
                highlightCornerRadius="24"
                marginLeft="7"
                marginRight="7"
                alignItems="center"
                justifyContent="center"
                height="48"
                width="48">
                <SVGImage
                    id="video/osd/lock/icon"
                    height="26"
                    width="26"
                    svg="@res/icon/player-unlock.svg" />
            </brls:Box>
        </brls:Box>

        <brls:Box
            cornerRadius="4"
            backgroundColor="@theme/brls/backdrop"
            detachedX="30"
            detachedY="-20"
            visibility="gone"
            height="32"
            id="video/osd/hint/box">
            <brls:Label
                id="video/osd/hint/label"
                marginLeft="10"
                marginRight="10"
                marginTop="4"
                marginBottom="4"
                maxWidth="600"
                textColor="@theme/color/white" />
        </brls:Box>
    </brls:Box>

</brls:Box>