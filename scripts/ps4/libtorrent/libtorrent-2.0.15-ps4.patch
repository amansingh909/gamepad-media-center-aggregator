 #define TORRENT_NO_FPU 1
 #define TORRENT_USE_I2P 0
 
+// ==== PS4 (OpenOrbis homebrew) ===
+// FreeBSD 9 kernel under a musl based libc. Socket structs and errno use the
+// BSD layout, but sysctl, getifaddrs, routing sockets, mmap'd disk I/O and
+// getrandom() aren't usable, so neither the BSD nor the Linux branch fits.
+// Interfaces and routes come from the application, see ps4_set_network().
+#elif defined __OPENORBIS__
+#define TORRENT_PS4
+#define TORRENT_HAVE_MMAP 0
+#define TORRENT_HAS_SYMLINK 0
+#define TORRENT_HAS_FALLOCATE 0
+#define TORRENT_USE_RLIMIT 0
+#define TORRENT_USE_IFADDRS 0
+#define TORRENT_USE_IFCONF 0
+#define TORRENT_USE_SYSCTL 0
+#define TORRENT_USE_GETRANDOM 0
+
 // ==== Darwin/BSD ===
 #elif (defined __APPLE__ && defined __MACH__) || defined __FreeBSD__ || defined __NetBSD__ \
 	|| defined __OpenBSD__ || defined __bsdi__ || defined __DragonFly__ \
